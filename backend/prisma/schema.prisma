generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["deltha"]
}

// Data model for the 'States' table
model State {
  state_code         Int            @id @default(autoincrement()) @map("state_code")
  municipalities     Municipality[]
  name               String         @db.VarChar(255) @map("name")
  abbreviation       String         @db.VarChar(2) @map("abbreviation") 
  created_at         DateTime       @default(now()) @map("created_at")
  updated_at         DateTime       @updatedAt @map("updated_at")
  @@schema("deltha")
  @@map("states")
}

// Data model for the 'Municipalities' table
model Municipality {
  municipality_code  Int       @id @default(autoincrement()) @map("municipality_code")
  companies          Company[]
  name               String    @db.VarChar(100) @map("name")
  ibge_code          Int?      @map("ibge_code")
  state_code         Int       @map("state_code")
  state              State     @relation(fields: [state_code], references: [state_code])
  created_at         DateTime  @default(now()) @map("created_at")
  updated_at         DateTime  @updatedAt @map("updated_at")
  @@schema("deltha")
  @@map("municipalities")
}

// Data model for the 'Companies' table
model Company {
  company_code       Int           @id @default(autoincrement()) @map("company_code")
  employees          Employee[]
  departments        Department[]
  functions          Function[]
  tax_id_type        Int           @map("tax_id_type")
  tax_id             String        @map("tax_id")
  corporate_name     String        @db.VarChar(100) @map("corporate_name")
  municipality_code  Int           @map("municipality_code")
  municipality       Municipality  @relation(fields: [municipality_code], references: [municipality_code])
  name               String?       @db.VarChar(100) @map("name")
  address            String?       @db.VarChar(40) @map("address")
  address_number     Int?          @map("address_number")
  address_complement String?       @db.VarChar(30) @map("address_complement")
  postal_code        String?       @db.VarChar(8) @map("postal_code")
  neighborhood       String?       @db.VarChar(60) @map("neighborhood")
  area_code          String?       @db.VarChar(3) @map("area_code")
  phone              String?       @db.VarChar(14) @map("phone")
  email              String?       @db.VarChar(255) @map("email")
  created_at         DateTime      @default(now()) @map("created_at")
  updated_at         DateTime      @updatedAt @map("updated_at")
  @@schema("deltha")
  @@map("companies")
}

// Data model for the 'Departments' table
model Department {
  department_code    Int       @id @default(autoincrement()) @map("department_code")
  functions          Function[]
  employees          Employee[]
  company_code       Int       @map("company_code")
  company            Company   @relation(fields: [company_code], references: [company_code])
  name               String    @db.VarChar(100) @map("name")
  description        String    @db.VarChar(255) @map("description")
  created_at         DateTime  @default(now()) @map("created_at")
  updated_at         DateTime  @updatedAt @map("updated_at")
  @@schema("deltha")
  @@map("departments")
}

// Data model for the 'Departments' table
model Function {
  function_code      Int        @id @default(autoincrement()) @map("function_code")
  employees          Employee[]
  company_code       Int        @map("company_code")
  company            Company    @relation(fields: [company_code], references: [company_code])
  department_code    Int        @map("department_code")
  department         Department @relation(fields: [department_code], references: [department_code])
  name               String     @db.VarChar(100) @map("name")
  description        String     @db.VarChar(255) @map("description")
  created_at         DateTime   @default(now()) @map("created_at")
  updated_at         DateTime   @updatedAt @map("updated_at")
  @@schema("deltha")
  @@map("functions")
}

// Data Model for the 'Employees' table
model Employee {
  employee_code      Int         @id @default(autoincrement()) @map("employee_code")
  company_code       Int         @map("company_code")
  company            Company     @relation(fields: [company_code], references: [company_code])
  function_code      Int         @map("function_code")
  function           Function    @relation(fields: [function_code], references: [function_code])
  department_code    Int         @map("department_code")
  department         Department  @relation(fields: [department_code], references: [department_code])
  position_code      Int         @map("position_code")
  first_name         String      @db.VarChar(100) @map("first_name")
  last_name          String      @db.VarChar(100) @map("last_name")
  email              String      @db.VarChar(255) @map("email")
  hire_date          DateTime    @db.Date @map("hire_date")
  salary             Decimal     @db.Decimal(10, 2) @map("salary")
  is_active          Boolean     @default(true) @map("is_active")
  municipality_code  Int?        @map("municipality_code")
  phone              String?     @db.VarChar(20) @map("phone")
  date_of_birth      DateTime?   @db.Date @map("date_of_birth")
  termination_date   DateTime?   @db.Date @map("termination_date")
  address            String?     @db.VarChar(255) @map("address")
  address_number     String?     @db.VarChar(20) @map("address_number")
  address_complement String?     @db.VarChar(100) @map("address_complement")
  postal_code        String?     @db.VarChar(20) @map("postal_code")
  neighborhood       String?     @db.VarChar(100) @map("neighborhood")
  area_code          Int?        @map("area_code")
  national_id        String?     @db.VarChar(20) @map("national_id")
  created_at         DateTime    @default(now()) @map("created_at")
  updated_at         DateTime    @updatedAt @map("updated_at")
  @@schema("deltha")
  @@map("employees")
}
